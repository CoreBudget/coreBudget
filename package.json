{
  "name": "corebudget",
  "version": "0.1.0",
  "description": "Self-hosted, multi-user personal finance app for zero-based budgeting and net worth tracking.",
  "keywords": [
    "budgeting",
    "personal-finance",
    "envelope-budgeting",
    "net-worth",
    "self-hosted",
    "nextjs",
    "docker"
  ],
  "homepage": "https://github.com/chiefpansancolt/coreBudget#readme",
  "bugs": {
    "url": "https://github.com/chiefpansancolt/coreBudget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiefpansancolt/coreBudget.git"
  },
  "author": "Christopher Pezza",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "backup:decrypt": "tsx scripts/decrypt-backup.ts",
    "knip": "knip",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-charts": "^9.13.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@serwist/turbopack": "^9.5.12",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "esbuild": "^0.28.2",
    "geoip-lite": "^2.0.3",
    "iron-session": "^9.0.1",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "commit-and-tag-version": "^13.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "browserslist": "4.28.9",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}

DATABASE_URL="postgresql://postgres@localhost:5432/corebudget?schema=public"

# Application-level encryption key for the SMTP password and encrypted backups.
# Generate a real one: openssl rand -base64 32
APP_ENCRYPTION_KEY="generate-with-openssl-rand--base64-32"

# Externally-reachable base URL, used to build invite/password-reset links.
APP_URL="http://localhost:3000"

# iron-session cookie encryption password (>= 32 chars).
SESSION_SECRET="generate-with-openssl-rand--base64-32"

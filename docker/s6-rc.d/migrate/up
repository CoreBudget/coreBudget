#!/bin/sh
set -e

if [ -z "$DATABASE_URL" ]; then
  export PATH="/usr/lib/postgresql/18/bin:$PATH"
  # initdb only creates the default 'postgres' database, so create the app's own database too.
  # Idempotent: this oneshot reruns on every container start, not just the first.
  psql -h 127.0.0.1 -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname='corebudget'" |
    grep -q 1 || psql -h 127.0.0.1 -U postgres -c "CREATE DATABASE corebudget"
  export DATABASE_URL="postgresql://postgres@127.0.0.1:5432/corebudget?schema=public"
fi

cd /app
npx prisma migrate deploy --schema=prisma/schema.prisma
